<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout - CarryMe Store | Razorpay Payment Gateway</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            color: #f5f5f5;
            line-height: 1.6;
        }

        header {
            background: linear-gradient(135deg, #2d1810 0%, #1a0f0a 100%);
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #d4af37;
            text-decoration: none;
        }

        nav a {
            color: #f5f5f5;
            text-decoration: none;
            margin-left: 30px;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #d4af37;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .checkout-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .checkout-header h1 {
            font-size: 42px;
            color: #d4af37;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .checkout-header p {
            color: #b0b0b0;
            font-size: 16px;
        }

        .checkout-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
            margin-bottom: 50px;
        }

        .payment-methods {
            background: linear-gradient(135deg, #2d2d2d 0%, #1f1f1f 100%);
            padding: 30px;
            border-radius: 15px;
            border: 1px solid #404040;
        }

        .payment-method {
            display: flex;
            align-items: center;
            padding: 20px;
            margin-bottom: 15px;
            border: 2px solid #404040;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .payment-method:hover {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.05);
        }

        .payment-method input[type="radio"] {
            margin-right: 20px;
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .payment-method-content {
            flex: 1;
        }

        .payment-method-title {
            color: #d4af37;
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .payment-method-desc {
            color: #888;
            font-size: 13px;
        }

        .payment-method.active {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.1);
        }

        .razorpay-section {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #404040;
        }

        .razorpay-section h3 {
            color: #d4af37;
            margin-bottom: 20px;
            font-size: 18px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #d4af37;
            margin-bottom: 8px;
            font-weight: bold;
            font-size: 14px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #404040;
            background: #1a1a1a;
            color: #f5f5f5;
            border-radius: 6px;
            font-family: inherit;
            font-size: 14px;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
        }

        .bank-details {
            background: rgba(212, 175, 55, 0.1);
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #d4af37;
            margin-top: 20px;
        }

        .bank-details h4 {
            color: #d4af37;
            margin-bottom: 15px;
            font-size: 16px;
        }

        .bank-detail-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #404040;
            color: #b0b0b0;
        }

        .bank-detail-row:last-child {
            border-bottom: none;
        }

        .order-summary {
            background: linear-gradient(135deg, #2d2d2d 0%, #1f1f1f 100%);
            padding: 30px;
            border-radius: 15px;
            border: 1px solid #404040;
            position: sticky;
            top: 100px;
        }

        .order-summary h3 {
            color: #d4af37;
            margin-bottom: 20px;
            font-size: 18px;
            border-bottom: 1px solid #404040;
            padding-bottom: 15px;
        }

        .order-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            color: #b0b0b0;
        }

        .order-item-name {
            flex: 1;
        }

        .order-item-price {
            color: #d4af37;
            font-weight: bold;
        }

        .order-summary hr {
            border: none;
            border-top: 1px solid #404040;
            margin: 15px 0;
        }

        .order-total {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: bold;
            color: #d4af37;
        }

        .checkout-btn {
            width: 100%;
            padding: 15px;
            background: #d4af37;
            color: #1a1a1a;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            margin-top: 20px;
            transition: all 0.3s;
        }

        .checkout-btn:hover {
            background: #e5c158;
            transform: scale(1.02);
        }

        .checkout-btn:disabled {
            background: #666;
            cursor: not-allowed;
            transform: scale(1);
        }

        .security-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            padding: 10px;
            background: rgba(6, 168, 125, 0.1);
            border: 1px solid #06a87d;
            border-radius: 6px;
            color: #06a87d;
            font-size: 13px;
            justify-content: center;
        }

        footer {
            background: #1a0f0a;
            color: #d4af37;
            text-align: center;
            padding: 30px;
            margin-top: 50px;
            border-top: 2px solid #d4af37;
        }

        @media (max-width: 768px) {
            .checkout-container {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
                top: auto;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-content">
            <a href="index.html" class="logo">✦ CarryMe Store ✦</a>
            <nav>
                <a href="index.html">Home</a>
                <a href="products.html">Collections</a>
                <a href="videos.html">Videos</a>
                <a href="checkout.html">Cart</a>
            </nav>
        </div>
    </header>

    <div class="container">
        <div class="checkout-header">
            <h1>🛒 Secure Checkout</h1>
            <p>Choose your preferred payment method</p>
        </div>

        <div class="checkout-container">
            <!-- Payment Methods -->
            <div class="payment-methods">
                <!-- Razorpay Payment -->
                <label class="payment-method active" onclick="selectPayment('razorpay')">
                    <input type="radio" name="payment" value="razorpay" checked>
                    <div class="payment-method-content">
                        <div class="payment-method-title">💳 Card / UPI / Net Banking</div>
                        <div class="payment-method-desc">Pay securely via Razorpay - Fastest & Safest</div>
                    </div>
                </label>

                <!-- Bank Transfer -->
                <label class="payment-method" onclick="selectPayment('bank')">
                    <input type="radio" name="payment" value="bank">
                    <div class="payment-method-content">
                        <div class="payment-method-title">🏦 Bank Transfer</div>
                        <div class="payment-method-desc">Direct bank transfer to our account</div>
                    </div>
                </label>

                <!-- Cash on Delivery -->
                <label class="payment-method" onclick="selectPayment('cod')">
                    <input type="radio" name="payment" value="cod">
                    <div class="payment-method-content">
                        <div class="payment-method-title">💵 Cash on Delivery</div>
                        <div class="payment-method-desc">Pay when you receive your order</div>
                    </div>
                </label>

                <!-- Razorpay Section -->
                <div class="razorpay-section" id="razorpay-details">
                    <h3>Complete Your Payment</h3>
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" id="customerName" placeholder="Enter your name" required>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" id="customerEmail" placeholder="your@email.com" required>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" id="customerPhone" placeholder="+91 XXXXXXXXXX" required>
                    </div>
                    <button class="checkout-btn" onclick="initiateRazorpayPayment()">Proceed to Payment →</button>
                </div>

                <!-- Bank Transfer Section (Hidden) -->
                <div id="bank-details" style="display: none;">
                    <h3 style="color: #d4af37; margin-bottom: 20px;">Bank Transfer Details</h3>
                    <div class="bank-details">
                        <h4>Account Information</h4>
                        <div class="bank-detail-row">
                            <span>Account Holder:</span>
                            <strong style="color: #d4af37;">CarryMe Store Pvt. Ltd</strong>
                        </div>
                        <div class="bank-detail-row">
                            <span>Account Number:</span>
                            <strong style="color: #d4af37;">12345678901234</strong>
                        </div>
                        <div class="bank-detail-row">
                            <span>Bank Name:</span>
                            <strong style="color: #d4af37;">HDFC Bank</strong>
                        </div>
                        <div class="bank-detail-row">
                            <span>IFSC Code:</span>
                            <strong style="color: #d4af37;">HDFC0001234</strong>
                        </div>
                        <div class="bank-detail-row">
                            <span>Branch:</span>
                            <strong style="color: #d4af37;">Delhi Main Branch</strong>
                        </div>
                    </div>
                    <div class="form-group" style="margin-top: 20px;">
                        <label>Transaction Reference</label>
                        <input type="text" id="transRef" placeholder="Enter bank transfer reference number" required>
                    </div>
                    <div class="form-group">
                        <label>Your Name</label>
                        <input type="text" id="bankName" placeholder="Enter your name" required>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="bankEmail" placeholder="your@email.com" required>
                    </div>
                    <button class="checkout-btn" onclick="submitBankTransfer()">Confirm Transfer →</button>
                </div>

                <!-- Cash on Delivery Section (Hidden) -->
                <div id="cod-details" style="display: none;">
                    <h3 style="color: #d4af37; margin-bottom: 20px;">Delivery Address</h3>
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" id="codName" placeholder="Enter recipient name" required>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="codEmail" placeholder="your@email.com" required>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" id="codPhone" placeholder="+91 XXXXXXXXXX" required>
                    </div>
                    <div class="form-group">
                        <label>Street Address</label>
                        <input type="text" id="codAddress" placeholder="House/Apt, Street" required>
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" id="codCity" placeholder="City" required>
                    </div>
                    <div class="form-group">
                        <label>Pin Code</label>
                        <input type="text" id="codPin" placeholder="110001" required>
                    </div>
                    <div class="form-group">
                        <label>Special Instructions</label>
                        <textarea id="codInstructions" placeholder="Any special delivery instructions..." style="min-height: 80px;"></textarea>
                    </div>
                    <button class="checkout-btn" onclick="submitCOD()">Place Order →</button>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="order-summary">
                <h3>📦 Order Summary</h3>
                <div class="order-item">
                    <span class="order-item-name">Classic Terracotta Necklace</span>
                    <span class="order-item-price">₹599</span>
                </div>
                <div class="order-item">
                    <span class="order-item-name">Golden Earrings Set</span>
                    <span class="order-item-price">₹399</span>
                </div>
                <div class="order-item">
                    <span class="order-item-name">Elegant Bracelet</span>
                    <span class="order-item-price">₹349</span>
                </div>
                <hr>
                <div class="order-item">
                    <span>Subtotal:</span>
                    <span class="order-item-price">₹1,347</span>
                </div>
                <div class="order-item">
                    <span>Shipping:</span>
                    <span class="order-item-price">Free</span>
                </div>
                <div class="order-item">
                    <span>Tax (18%):</span>
                    <span class="order-item-price">₹242</span>
                </div>
                <hr>
                <div class="order-total">
                    <span>Total Amount:</span>
                    <span>₹1,589</span>
                </div>
                <div class="security-badge">
                    🛡️ 100% Secure & Encrypted Payment
                </div>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 CarryMe Store. Handcrafted with Love. All rights reserved.</p>
        <p>All transactions are secure and encrypted</p>
    </footer>

    <!-- Razorpay Script -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
        const RAZORPAY_KEY = "YOUR_RAZORPAY_KEY_ID"; // Replace with your actual Razorpay Key
        const ORDER_AMOUNT = 158900; // Amount in paise (₹1,589.00)

        function selectPayment(method) {
            document.getElementById('razorpay-details').style.display = method === 'razorpay' ? 'block' : 'none';
            document.getElementById('bank-details').style.display = method === 'bank' ? 'block' : 'none';
            document.getElementById('cod-details').style.display = method === 'cod' ? 'block' : 'none';
        }

        function initiateRazorpayPayment() {
            const name = document.getElementById('customerName').value;
            const email = document.getElementById('customerEmail').value;
            const phone = document.getElementById('customerPhone').value;

            if (!name || !email || !phone) {
                alert('Please fill in all details');
                return;
            }

            const options = {
                key: RAZORPAY_KEY,
                amount: ORDER_AMOUNT,
                currency: 'INR',
                name: 'CarryMe Store',
                description: 'Handcrafted Jewelry Purchase',
                image: 'https://deveshdu-hub.github.io/carryme/logo.png',
                prefill: {
                    name: name,
                    email: email,
                    contact: phone
                },
                handler: function(response) {
                    alert('Payment successful! Transaction ID: ' + response.razorpay_payment_id);
                    // Here you would typically send the payment confirmation to your backend
                },
                modal: {
                    ondismiss: function() {
                        alert('Payment cancelled');
                    }
                }
            };

            const razorpay = new Razorpay(options);
            razorpay.open();
        }

        function submitBankTransfer() {
            const ref = document.getElementById('transRef').value;
            const name = document.getElementById('bankName').value;
            const email = document.getElementById('bankEmail').value;

            if (!ref || !name || !email) {
                alert('Please fill in all details');
                return;
            }

            alert(`Thank you! We've received your bank transfer.\n\nReference: ${ref}\nAmount: ₹1,589\n\nYour order will be confirmed shortly.`);
            // Send to your backend
        }

        function submitCOD() {
            const name = document.getElementById('codName').value;
            const email = document.getElementById('codEmail').value;
            const phone = document.getElementById('codPhone').value;
            const address = document.getElementById('codAddress').value;
            const city = document.getElementById('codCity').value;
            const pin = document.getElementById('codPin').value;

            if (!name || !email || !phone || !address || !city || !pin) {
                alert('Please fill in all delivery details');
                return;
            }

            alert(`Thank you for your order!\n\nDelivery Address:\n${address}\n${city} - ${pin}\n\nAmount: ₹1,589 (COD)\n\nWe'll contact you soon!`);
            // Send to your backend
        }
    </script>
</body>
</html>
